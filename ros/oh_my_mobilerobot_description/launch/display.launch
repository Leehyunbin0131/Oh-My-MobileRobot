<?xml version="1.0"?>
<launch>
  <arg name="variant" default="base" doc="base, cargo, arm, or display"/>
  <arg name="model" default="$(find oh_my_mobilerobot_description)/urdf/$(arg variant).urdf"/>
  <arg name="gui" default="true"/>
  <arg name="publish_joint_states" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="use_sim_time" default="false"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <param name="robot_description" textfile="$(arg model)"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>
  <group if="$(arg publish_joint_states)">
    <node if="$(arg gui)" name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"/>
    <node unless="$(arg gui)" name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>
  </group>
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find oh_my_mobilerobot_description)/rviz/ros1.rviz"/>
</launch>
